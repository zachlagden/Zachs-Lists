  {
    "name": "duplicates_count_once",
    "input": "example.com\nEXAMPLE.com\n@@example.net\n@@Example.net\n*.example.org\n*.EXAMPLE.org\n/^a$/\n/^a$/",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 1,
        "subdomain": 1,
        "wildcard": 1,
        "regex": 1
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["example.com", "x.example.net", "x.example.org"],
    "nonmatches": []
