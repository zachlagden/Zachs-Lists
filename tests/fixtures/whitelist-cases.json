[
  {
    "name": "exact_entry_is_lowercased_and_matches_only_itself",
    "input": "Example.COM # inline comment",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 1,
        "subdomain": 0,
        "wildcard": 0,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["example.com"],
    "nonmatches": ["sub.example.com", "example.org"]
  },
  {
    "name": "subdomain_entry_matches_the_domain_and_every_subdomain",
    "input": "@@Example.COM",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 1,
        "wildcard": 0,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["example.com", "sub.example.com", "a.b.example.com"],
    "nonmatches": ["notexample.com", "example.com.other", "example.org"]
  },
  {
    "name": "wildcard_matches_subdomains_but_not_the_domain",
    "input": "*.example.com",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 1,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["sub.example.com", "a.b.example.com"],
    "nonmatches": ["example.com", "notexample.com", "example.org"]
  },
  {
    "name": "uppercase_wildcard_matches_lowercase_domains",
    "input": "*.Example.COM\nAD*.Example.NET",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 2,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["sub.example.com", "ads.example.net"],
    "nonmatches": ["example.com", "bad.example.net"]
  },
  {
    "name": "partial_label_and_repeated_stars",
    "input": "ad*.exa*ple.com\na******.example.net",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 2,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": [
      "ads.example.com",
      "ad.exaple.com",
      "ads.a.example.com",
      "a.example.net",
      "abc.example.net"
    ],
    "nonmatches": ["bad.example.com", "ad.example.org", "b.example.net"]
  },
  {
    "name": "broad_wildcards",
    "input": "*\n*.*",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 2,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["example.com", "a.b.example.net"],
    "nonmatches": []
  },
  {
    "name": "regex_uses_rust_syntax_unanchored_and_case_sensitive",
    "input": "/google\\.(com|co\\.uk)$/\n/(?i)^EXAMPLE\\.net$/\n/^Upper\\.example$/",
    "expected": {
      "valid": true,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 0,
        "regex": 3
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["google.com", "sub.google.co.uk", "example.net"],
    "nonmatches": ["google.de", "sub.example.net", "upper.example"]
  },
  {
    "name": "comments_blank_lines_and_crlf",
    "input": "# full line comment\r\n\r\n  example.com # inline comment\r\n @@example.net \r\n\t\r\n  #DISABLED: not a domain?\r\n",
    "expected": {
      "valid": true,
      "patterns": {
