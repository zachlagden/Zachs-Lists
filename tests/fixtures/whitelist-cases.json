        "subdomain": 1,
        "wildcard": 0,
        "regex": 0
      },
      "errors": [],
      "error_counts": {}
    },
    "matches": ["example.com", "sub.example.net"],
    "nonmatches": ["sub.example.com"]
  },
  {
    "name": "empty_whitelist",
