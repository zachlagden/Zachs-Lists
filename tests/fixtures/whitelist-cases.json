  {
    "name": "lookahead_and_backreference_rejected_with_line_numbers",
    "input": "# first line\n/(?=secret)secret/\n/^([a-z]+)\\1\\.com$/\n/(?<!a)b/\nexample.com",
    "expected": {
      "valid": false,
      "patterns": {
        "exact": 1,
        "subdomain": 0,
        "wildcard": 0,
        "regex": 0
      },
      "errors": [
        {
          "line": 2,
          "content": "/(?=secret)secret/",
          "code": "unsupported_regex",
          "message": "Lookahead and lookbehind are not supported. Patterns use Rust regex syntax"
        },
        {
          "line": 3,
          "content": "/^([a-z]+)\\1\\.com$/",
          "code": "unsupported_regex",
          "message": "Backreferences are not supported. Patterns use Rust regex syntax"
        },
        {
          "line": 4,
          "content": "/(?<!a)b/",
          "code": "unsupported_regex",
          "message": "Lookahead and lookbehind are not supported. Patterns use Rust regex syntax"
        }
      ],
      "error_counts": {
        "unsupported_regex": 3
      }
    },
    "matches": ["example.com"],
    "nonmatches": ["secret"]
  },
  {
    "name": "one_bad_line_among_good_ones",
    "input": "good.example\n@@parent.example\nnot a domain\n*.wild.example\n/^re[0-9]\\.example$/",
    "expected": {
      "valid": false,
      "patterns": {
        "exact": 1,
        "subdomain": 1,
        "wildcard": 1,
        "regex": 1
      },
      "errors": [
        {
          "line": 3,
          "content": "not a domain",
          "code": "invalid_domain",
          "message": "Not a valid domain. Use letters, digits, hyphens and dots, such as example.com, and write internationalised names in punycode"
        }
      ],
      "error_counts": {
        "invalid_domain": 1
      }
    },
    "matches": ["good.example", "a.parent.example", "a.wild.example", "re1.example"],
    "nonmatches": ["not", "domain"]
  },
  {
    "name": "malformed_regex_forms",
    "input": "//\n/\n/unterminated\n/^a#b$/",
    "expected": {
      "valid": false,
      "patterns": {
        "exact": 0,
        "subdomain": 0,
        "wildcard": 0,
        "regex": 0
      },
      "errors": [
        {
          "line": 1,
          "content": "//",
          "code": "malformed_regex",
          "message": "A regex must start and end with / and have a pattern between them. Write a literal # as \\x23, because # starts a comment"
        },
        {
          "line": 2,
          "content": "/",
          "code": "malformed_regex",
          "message": "A regex must start and end with / and have a pattern between them. Write a literal # as \\x23, because # starts a comment"
        },
        {
          "line": 3,
          "content": "/unterminated",
          "code": "malformed_regex",
          "message": "A regex must start and end with / and have a pattern between them. Write a literal # as \\x23, because # starts a comment"
        },
        {
          "line": 4,
          "content": "/^a",
          "code": "malformed_regex",
          "message": "A regex must start and end with / and have a pattern between them. Write a literal # as \\x23, because # starts a comment"
        }
      ],
      "error_counts": {
        "malformed_regex": 4
      }
    },
    "matches": [],
    "nonmatches": []
  },
