# =============================================================================
# Unified Environment Configuration
# Used by: Backend (Flask), Frontend (Vite), Worker (Rust)
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# CHANGED FOR DOCKER: Host is 'mongo' instead of 'localhost'
MONGO_URI=mongodb://mongo:27017/blocklist
DATABASE_NAME=blocklist

# -----------------------------------------------------------------------------
# Data Directory
# Shared between all services
# -----------------------------------------------------------------------------
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# Flask Backend Configuration
# -----------------------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production

# GitHub OAuth
# Create a GitHub OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Root user (super admin) - REQUIRED
ROOT_USERNAME=your-github-username

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# GeoIP Database (optional, for analytics)
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb

# Seconds between Flask's checks for job changes to relay to browsers.
# The active interval applies while a build is queued or running, the idle one otherwise.
# JOB_POLL_ACTIVE_SECONDS=0.5
# JOB_POLL_IDLE_SECONDS=2

# Redis (optional, for rate limiting persistence)
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Frontend (Vite) Configuration
# VITE_ prefix required for Vite to expose to client
# -----------------------------------------------------------------------------
VITE_API_URL=
VITE_SITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Rust Worker Configuration
# -----------------------------------------------------------------------------
# Path to the worker binary. Flask also runs it to check a whitelist before
# saving it. The Docker image uses /app/rust-worker, so set this only when
# running outside Docker.
# WORKER_BIN=/path/to/rust-worker/target/release/blocklist-worker

# Progress update interval (milliseconds) - how often to update MongoDB with progress
PROGRESS_UPDATE_INTERVAL_MS=500

# Heartbeat interval (seconds) - how often worker reports it's alive
HEARTBEAT_INTERVAL_SECS=10

# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=10

# HTTP request timeout (seconds)
HTTP_TIMEOUT_SECS=60

# Seconds a checked source is reused without contacting its upstream (0 checks on every build; forced rebuilds always check)
SOURCE_FRESH_SECS=3600

# Cache configuration
CACHE_TTL_DAYS=7
MAX_CACHE_SIZE_BYTES=10737418240
